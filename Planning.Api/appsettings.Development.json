{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3100",
      "http://127.0.0.1:3100"
    ]
  },
  "Email": {
    // No SmtpHost, so nothing is actually sent: outgoing mail is written to the console instead,
    // link and all. AppBaseUrl still has to be right, or that link points nowhere useful.
    "AppBaseUrl": "http://localhost:3000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
