{
  // Testmodus: zet ASPNETCORE_ENVIRONMENT=Test en start met --no-launch-profile
  // PowerShell: $env:ASPNETCORE_ENVIRONMENT="Test"; dotnet run --project Planning.Api --no-launch-profile
  // De connection string komt uit user-secrets of ConnectionStrings__DefaultConnection,
  // omdat een Postgres-string een wachtwoord bevat en dit bestand in git staat.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3100",
      "http://127.0.0.1:3100"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Planning.Infrastructure.Data.TestDataSeeder": "Information"
    }
  }
}
