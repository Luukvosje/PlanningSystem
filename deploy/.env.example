# Copy to .env on the VPS (in /opt/planning) and fill in real values.
#   cp .env.example .env && chmod 600 .env
# Never commit the filled-in file - it holds every production secret in one place.

# --- Domain and TLS -----------------------------------------------------------------------
# The single public domain. Frontend and API share it: /api and /img go to the API, the rest to
# the frontend, which is why production has no cross-origin requests at all.
APP_DOMAIN=app.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# --- Container images ---------------------------------------------------------------------
# Your GitHub account or organization; images are pulled from ghcr.io/<owner>/planningsystem-*.
GITHUB_REPOSITORY_OWNER=Luukvosje
# The deploy workflow rewrites this to the commit SHA it just shipped. To roll back, set it to
# an earlier SHA and run: docker compose pull api web && docker compose up -d
IMAGE_TAG=latest

# --- Database -----------------------------------------------------------------------------
POSTGRES_USER=planning
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=planning

# --- Authentication -------------------------------------------------------------------------
# Signing key for JWTs. Generate with: openssl rand -base64 64
# Changing it logs every user out immediately, which is also how you revoke all sessions at once.
JWT_KEY=
JWT_ISSUER=Planning.Api
JWT_AUDIENCE=Planning.Api

# --- Email ----------------------------------------------------------------------------------
# Transactional provider over SMTP (Resend, SMTP2GO, Postmark, ...). Port 587 uses STARTTLS.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Must be an address on a domain whose SPF and DKIM records point at your provider, otherwise
# Gmail and Outlook will quietly drop the mail.
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Planning

# --- Backups ----------------------------------------------------------------------------------
# Passphrase for the encrypted off-site backup. Generate with: openssl rand -base64 32
# Store a copy somewhere outside this server - without it the backups cannot be restored.
RESTIC_PASSWORD=
# Off-site target, e.g. an SFTP path on a Hetzner Storage Box:
#   sftp:u123456@u123456.your-storagebox.de:/planning
RESTIC_REPOSITORY=
# How many days of local dumps to keep in /opt/planning/backups.
BACKUP_RETENTION_DAYS=7
